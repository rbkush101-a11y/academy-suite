(scholarshipPercent > 0 ? '<div class="field"><b>Scholarship :</b><span class="value">' + scholarshipPercent + '% (Rs. ' + scholarshipAmount + ')</span></div>' : '') +
'<div class="field"><b>Tuition Fee :</b><span class="value">Rs. ' + data.amount + '</span></div>' +
'<div class="field"><b>Late Fee :</b><span class="value">Rs. ' + lateFee + '</span></div>' +
'<div class="field"><b>Payment Status :</b><span class="value status">' + paymentStatus + '</span></div>' +
'<div class="options payment-options"><b>Payment Method :</b> &nbsp; <b>Cash</b> ' + (paymentMethod === "CASH" ? "☑" : "□") +
'&nbsp;&nbsp; <b>UPI</b> ' + (paymentMethod === "UPI" ? "☑" : "□") +
'&nbsp;&nbsp; <b>Online</b> ' + (paymentMethod === "ONLINE" ? "☑" : "□") +
'&nbsp;&nbsp; <b>Cheque</b> ' + (paymentMethod === "CHEQUE" ? "☑" : "□") + '</div>' +
'<div class="amount"><div class="rs">Rs.</div><div class="value">' + totalAmount + '</div></div>' +
'<div class="signatures"><div class="line">Authorized Signature</div></div>' +
'</div>' +

'</div></div></div>' +
'<script>window.onload = function () { window.print(); };</script>' +
'</body>' +
'</html>';

receiptWindow.document.write(html);
receiptWindow.document.close();
};

const handleDeletePayment = (payment: any) => {
const confirmed = confirm(
'Delete payment for "' + (payment.studentName || "student") + '"?'
);

if (!confirmed) return;

deletePayment.mutate(payment.id, {
onSuccess: () => {
refreshFinanceData();
},
onError: (error: any) => {
alert(error?.message || "Payment could not be deleted.");
},
});
};

const handleSavePayment = () => {
if (
!paymentForm.studentId ||
!paymentForm.feeStructureId ||
!paymentForm.amount ||
!paymentForm.dueDate ||
!paymentForm.month
) {
alert("Please fill all payment details.");
return;
}

const onSuccess = () => {
refreshFinanceData();
setPaymentDialogOpen(false);
setEditingPayment(null);
};

const onError = (error: any) => {
alert(
error?.message ||
"Payment could not be saved. Check backend terminal."
);
};

if (editingPayment) {
updatePayment.mutate(
{
id: editingPayment.id,
data: {
originalAmount: Number(paymentForm.amount),
scholarshipPercent: Number(paymentForm.scholarshipPercent || 0),
dueDate: paymentForm.dueDate,
month: paymentForm.month,
paymentMethod: paymentForm.paymentMethod,
installment: paymentForm.installment,
status: paymentForm.status,
} as any,
},
{ onSuccess, onError }
);
return;
}

recordPayment.mutate(
{
data: {
studentId: paymentForm.studentId,
feeStructureId: paymentForm.feeStructureId,
amount: Number(paymentForm.amount),
scholarshipPercent: Number(paymentForm.scholarshipPercent || 0),
dueDate: paymentForm.dueDate,
month: paymentForm.month,
paymentMethod: paymentForm.paymentMethod as
| "cash"
| "online"
| "cheque"
| "upi",
installment: paymentForm.installment,
} as any,
},
{ onSuccess, onError }
);
};

const markPaymentPaid = (payment: any) => {
updatePayment.mutate(
{
id: payment.id,
data: {
status: "paid",
} as any,
},
{
onSuccess: () => {
refreshFinanceData();
},
onError: (error: any) => {
alert(
error?.message ||
"Payment status could not be updated. Check backend terminal."
);
},
}
);
};

const selectedFeeStructure = feeStructures?.find(
(feeStructure) => feeStructure.id === paymentForm.feeStructureId
);

const setSelectedFeeStructure = (feeStructureId: string) => {
const selected = feeStructures?.find(
(feeStructure) => feeStructure.id === feeStructureId
);

setPaymentForm((current) => ({
  ...current,
  feeStructureId,
  amount: selected ? String(selected.amount) : "",
}));

};

const openAssignmentDialog = () => {
  setAssignmentForm({
    studentId: "",
    feeStructureId: "",
    admissionDate: new Date().toISOString().split("T")[0],
    totalMonths: "12",
    scholarshipPercent: "0",
  });

  setAssignmentDialogOpen(true);
};

const handleSaveAssignment = () => {
  if (
    !assignmentForm.studentId ||
    !assignmentForm.feeStructureId ||
    !assignmentForm.admissionDate
  ) {
    alert("Student, fee structure aur admission date required hain.");
    return;
  }

  const totalMonths = Number(assignmentForm.totalMonths);
  const scholarshipPercent = Number(
    assignmentForm.scholarshipPercent
  );

  if (
    !Number.isInteger(totalMonths) ||
    totalMonths < 1 ||
    totalMonths > 120
  ) {
    alert("Total months 1 se 120 ke beech hona chahiye.");
    return;
  }

  if (
    !Number.isFinite(scholarshipPercent) ||
    scholarshipPercent < 0 ||
    scholarshipPercent > 100
  ) {
    alert("Scholarship 0 se 100 ke beech honi chahiye.");
    return;
  }

  const selectedStudent = students?.find(
    (student: any) => student.id === assignmentForm.studentId
  ) as any;

  createFeeAssignment.mutate({
    instituteId: selectedStudent?.instituteId || undefined,
    studentId: assignmentForm.studentId,
    feeStructureId: assignmentForm.feeStructureId,
    admissionDate: assignmentForm.admissionDate,
    totalMonths,
    scholarshipPercent,
  });
};

const handleDeleteAssignment = (assignment: any) => {
  const confirmed = confirm(
    `${assignment.studentName || "Student"} ka fee cycle delete karein?\n` +
      "Pending bills delete honge, paid history safe rahegi."
  );

  if (!confirmed) return;

  deleteFeeAssignment.mutate(assignment.id);
};

const formatDate = (date: string | null | undefined) => {
if (!date) return "-";

return new Date(date).toLocaleDateString("en-GB");

};

return (
<div className="space-y-6">
<div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
<h1 className="text-3xl font-bold tracking-tight">Finance</h1>

    <div className="flex gap-2">
      <Button variant="outline" onClick={openFeeStructureDialog}>
        <Plus className="mr-2 h-4 w-4" />
        Add Fee Structure
      </Button>

      <Button onClick={openPaymentDialog}>
        <Plus className="mr-2 h-4 w-4" />
        Add Payment
      </Button>

      <Button variant="outline" onClick={openAssignmentDialog}>
        <Plus className="mr-2 h-4 w-4" />
        Assign Fee Cycle
      </Button>
    </div>
  </div>

  <div className="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
    <Card>
      <CardContent className="p-6">
        <div className="flex items-center justify-between">
          <div>
            <p className="mb-1 text-sm font-medium text-muted-foreground">
              Total Revenue
            </p>
            <h3 className="text-2xl font-bold">
              ₹{summary?.totalRevenue?.toLocaleString() || 0}
            </h3>
          </div>

          <div className="rounded-xl bg-green-100 p-3 text-green-700 dark:bg-green-900/30 dark:text-green-400">
            <TrendingUp className="h-5 w-5" />
          </div>
        </div>
      </CardContent>
    </Card>

    <Card>
      <CardContent className="p-6">
        <div className="flex items-center justify-between">
          <div>
            <p className="mb-1 text-sm font-medium text-muted-foreground">
              Pending Fees
            </p>
            <h3 className="text-2xl font-bold">
              ₹{summary?.totalPending?.toLocaleString() || 0}
            </h3>
          </div>

          <div className="rounded-xl bg-blue-100 p-3 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400">
            <IndianRupee className="h-5 w-5" />
          </div>
        </div>
      </CardContent>
    </Card>

    <Card>
      <CardContent className="p-6">
        <div className="flex items-center justify-between">
          <div>
            <p className="mb-1 text-sm font-medium text-muted-foreground">
              Overdue Amount
            </p>
            <h3 className="text-2xl font-bold text-destructive">
              ₹{summary?.totalOverdue?.toLocaleString() || 0}
            </h3>
          </div>

          <div className="rounded-xl bg-red-100 p-3 text-red-700 dark:bg-red-900/30 dark:text-red-400">
            <AlertCircle className="h-5 w-5" />
          </div>
        </div>
      </CardContent>
    </Card>

    <Card>
      <CardContent className="p-6">
        <div className="flex items-center justify-between">
          <div>
            <p className="mb-1 text-sm font-medium text-muted-foreground">
              Collection Rate
            </p>
            <h3 className="text-2xl font-bold">
              {summary?.collectionRate || 0}%
            </h3>
          </div>

          <div className="rounded-xl bg-purple-100 p-3 text-purple-700 dark:bg-purple-900/30 dark:text-purple-400">
            <ArrowUpRight className="h-5 w-5" />
          </div>
        </div>
      </CardContent>
    </Card>
  </div>

<Dialog
  open={assignmentDialogOpen}
  onOpenChange={setAssignmentDialogOpen}
>
  <DialogContent className="sm:max-w-lg">
    <DialogHeader>
      <DialogTitle>Assign Student Fee Cycle</DialogTitle>
    </DialogHeader>

    <div className="space-y-4">
      <div className="space-y-2">
        <label className="text-sm font-medium">Student</label>

        <select
          className="h-10 w-full rounded-md border bg-background px-3 text-sm"
          value={assignmentForm.studentId}
          onChange={(event) =>
            setAssignmentForm((current) => ({
              ...current,
              studentId: event.target.value,
            }))
          }
        >
          <option value="">Select student</option>

          {students?.map((student: any) => (
            <option key={student.id} value={student.id}>
              {student.name} — {student.enrollmentNo}
            </option>
          ))}
        </select>
      </div>

      <div className="space-y-2">
        <label className="text-sm font-medium">
          Fee Structure
        </label>

