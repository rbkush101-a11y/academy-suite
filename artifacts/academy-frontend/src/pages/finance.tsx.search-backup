import {
useGetFinanceSummary,
useListPayments,
useListFeeStructures,
useCreateFeeStructure,
useUpdateFeeStructure,
useDeleteFeeStructure,
useRecordPayment,
useUpdatePayment,
useListCourses,
useListStudents,
getListFeeStructuresQueryKey,
getListPaymentsQueryKey,
getGetFinanceSummaryQueryKey,
} from "@workspace/api-client-react";
import { useState } from "react";
import {
  useMutation,
  useQuery,
  useQueryClient,
} from "@tanstack/react-query";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/ui/table";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Dialog, DialogContent, DialogHeader, DialogTitle } from "@/components/ui/dialog";
import { IndianRupee, TrendingUp, AlertCircle, ArrowUpRight, Plus, CheckCircle, Pencil, Trash2, ReceiptText } from "lucide-react";
import {
  financeApi,
  type FeeAssignment,
  type CreateFeeAssignmentInput,
  type CreateFeeAssignmentResult,
} from "../lib/finance-api";

export default function Finance() {
const [courseSearch, setCourseSearch] = useState("");
const [courseDropdownOpen, setCourseDropdownOpen] = useState(false);
const queryClient = useQueryClient();

const { data: summary } = useGetFinanceSummary();
const { data: payments, isLoading: isLoadingPayments } = useListPayments();
const { data: feeStructures, isLoading: isLoadingFeeStructures } =
useListFeeStructures();
const { data: courses } = useListCourses();
const { data: students } = useListStudents();

const createFeeStructure = useCreateFeeStructure();
const updateFeeStructure = useUpdateFeeStructure();
const deleteFeeStructure = useDeleteFeeStructure();
const recordPayment = useRecordPayment();
const updatePayment = useUpdatePayment();

const deletePayment = useMutation({
mutationFn: async (paymentId: string) => {
const token = localStorage.getItem("coach_sutra_token") || "";

const response = await fetch("/api/finance/payments/" + paymentId, {
  method: "DELETE",
  credentials: "include",
  headers: {
    "Content-Type": "application/json",
    ...(token
      ? {
          Authorization: "Bearer " + token,
        }
      : {}),
  },
});

if (!response.ok) {
  const body = await response.json().catch(() => null);

  throw new Error(
    body?.error || "Payment could not be deleted"
  );
}

},
});

const [feeDialogOpen, setFeeDialogOpen] = useState(false);
const [paymentDialogOpen, setPaymentDialogOpen] = useState(false);
const [editingPayment, setEditingPayment] = useState<any>(null);
const [editingFeeStructure, setEditingFeeStructure] = useState<any>(null);

const [feeForm, setFeeForm] = useState({
name: "",
courseId: "",
amount: "",
frequency: "monthly",
lateFeePerDay: "0",
dueDay: "10",
});

const [paymentForm, setPaymentForm] = useState({
studentId: "",
feeStructureId: "",
amount: "",
dueDate: new Date().toISOString().split("T")[0],
month: new Date().toISOString().slice(0, 7),
paymentMethod: "cash",
installment: "",
scholarshipPercent: "0",
status: "pending",
});

const [assignmentDialogOpen, setAssignmentDialogOpen] = useState(false);

const [assignmentForm, setAssignmentForm] = useState({
  studentId: "",
  feeStructureId: "",
  admissionDate: new Date().toISOString().split("T")[0],
  totalMonths: "12",
  scholarshipPercent: "0",
});

const {
  data: feeAssignments = [],
  isLoading: isLoadingAssignments,
} = useQuery<FeeAssignment[], Error>({
  queryKey: ["finance-fee-assignments"],
  queryFn: () => financeApi.listAssignments(),
});

const createFeeAssignment = useMutation<
  CreateFeeAssignmentResult,
  Error,
  CreateFeeAssignmentInput
>({
  mutationFn: (input) => financeApi.createAssignment(input),

  onSuccess: (result) => {
    queryClient.invalidateQueries({
      queryKey: ["finance-fee-assignments"],
    });

    queryClient.invalidateQueries({
      queryKey: getListPaymentsQueryKey(),
    });

    queryClient.invalidateQueries({
      queryKey: getGetFinanceSummaryQueryKey(),
    });

    setAssignmentDialogOpen(false);

    setAssignmentForm({
      studentId: "",
      feeStructureId: "",
      admissionDate: new Date().toISOString().split("T")[0],
      totalMonths: "12",
      scholarshipPercent: "0",
    });

    alert(
      `${result.paymentsGenerated} bills generated.\n` +
        `First due date: ${result.firstDueDate}\n` +
        `Last due date: ${result.lastDueDate}`
    );
  },

  onError: (error) => {
    alert(error.message || "Fee cycle create nahi ho saka.");
  },
});

const deleteFeeAssignment = useMutation({
  mutationFn: financeApi.deleteAssignment,

  onSuccess: () => {
    queryClient.invalidateQueries({
      queryKey: ["finance-fee-assignments"],
    });

    queryClient.invalidateQueries({
      queryKey: getListPaymentsQueryKey(),
    });

    queryClient.invalidateQueries({
      queryKey: getGetFinanceSummaryQueryKey(),
    });
  },

  onError: (error: Error) => {
    alert(error.message || "Fee cycle delete nahi ho saka.");
  },
});

const refreshFinanceData = () => {
queryClient.invalidateQueries({
queryKey: getListFeeStructuresQueryKey(),
});

queryClient.invalidateQueries({
  queryKey: getListPaymentsQueryKey(),
});

queryClient.invalidateQueries({
  queryKey: getGetFinanceSummaryQueryKey(),
});

};

const openFeeStructureDialog = () => {
  setEditingFeeStructure(null);
  setCourseSearch("");

  setFeeForm({
    name: "",
    courseId: "",
    amount: "",
    frequency: "monthly",
    lateFeePerDay: "0",
    dueDay: "10",
  });

  setFeeDialogOpen(true);
};

const openPaymentDialog = () => {
setEditingPayment(null);
setPaymentForm({
studentId: "",
feeStructureId: "",
amount: "",
dueDate: new Date().toISOString().split("T")[0],
month: new Date().toISOString().slice(0, 7),
paymentMethod: "cash",
installment: "",
scholarshipPercent: "0",
status: "pending",
});

setPaymentDialogOpen(true);

};

const openEditFeeStructureDialog = (feeStructure: any) => {
  setEditingFeeStructure(feeStructure);
  setCourseSearch("");

  setFeeForm({
    name: feeStructure.name ?? "",
    courseId: feeStructure.courseId ?? "",
    amount: String(feeStructure.amount ?? ""),
    frequency: feeStructure.frequency ?? "monthly",
    lateFeePerDay: String(feeStructure.lateFeePerDay ?? 0),
    dueDay: String(feeStructure.dueDay ?? 10),
  });

  setFeeDialogOpen(true);
};

const handleDeleteFeeStructure = (feeStructure: any) => {
const linkedPaymentExists = payments?.some(
(payment) => payment.feeStructureId === feeStructure.id
);

if (linkedPaymentExists) {
alert(
"This Fee Structure is already used in a payment, so it cannot be deleted."
);
return;
}

const confirmed = confirm(
'Delete Fee Structure "' + feeStructure.name + '"?'
);

if (!confirmed) {
return;
}

deleteFeeStructure.mutate(
{
id: feeStructure.id,
},
{
onSuccess: () => {
refreshFinanceData();
},
onError: (error: any) => {
alert(
error?.message ||
"Fee Structure could not be deleted. Check backend terminal."
);
},
}
);
};

const handleSaveFeeStructure = () => {
if (!feeForm.name || !feeForm.courseId || !feeForm.amount) {
alert("Please fill Fee Name, Course and Amount.");
return;
}

const data = {
name: feeForm.name,
courseId: feeForm.courseId,
amount: Number(feeForm.amount),
frequency: feeForm.frequency as
| "monthly"
| "quarterly"
| "annually"
| "one-time",
lateFeePerDay: Number(feeForm.lateFeePerDay || 0),
dueDay: Number(feeForm.dueDay || 10),
};

const onSuccess = () => {
refreshFinanceData();
setFeeDialogOpen(false);
setEditingFeeStructure(null);
};

const onError = (error: any) => {
alert(
error?.message ||
"Fee Structure could not be saved. Check backend terminal."
);
};

if (editingFeeStructure) {
updateFeeStructure.mutate(
{
id: editingFeeStructure.id,
data: data as any,
},
{
onSuccess,
onError,
}
);
return;
}

createFeeStructure.mutate(
{
data: data as any,
},
{
onSuccess,
onError,
}
);
};

const openEditPaymentDialog = (payment: any) => {
setEditingPayment(payment);

setPaymentForm({
studentId: payment.studentId ?? "",
feeStructureId: payment.feeStructureId ?? "",
amount: String(payment.originalAmount ?? payment.amount ?? ""),
dueDate: payment.dueDate ?? new Date().toISOString().split("T")[0],
month: payment.month ?? new Date().toISOString().slice(0, 7),
paymentMethod: payment.paymentMethod ?? "cash",
installment: payment.installment ?? "",
scholarshipPercent: String(payment.scholarshipPercent ?? 0),
status: payment.status ?? "pending",
});

setPaymentDialogOpen(true);
};

