'.amount .value { font-size: 21px; padding: 5px 12px; text-align: center; }' +
'.options { width: 100%; text-align: center; font-size: 11px; padding: 5px 0; }' +
'.payment-options { margin-top: 3px; border: 1px solid #555; border-radius: 3px; }' +
'.signatures { width: 100%; display: flex; justify-content: flex-end; text-align: center; padding: 8px 20px 3px; font-size: 10px; }' +
'.signatures .line { border-top: 1px solid #111; padding-top: 4px; width: 155px; }' +
'@media print { body { -webkit-print-color-adjust: exact; print-color-adjust: exact; } }' +
'</style>' +
'</head>' +
'<body>' +
'<div class="print-page"><div class="receipt">' +
'<img class="watermark" src="data:image/jpeg;base64," alt="" />' +
'<div class="receipt-content">' +
'<img class="header-image" src="data:image/png;base64," alt="Second School Classes" />' +
'<div class="title">TUITION FEE RECEIPT</div>' +
'<div class="top-row">' +
'<div><b>Receipt No.</b><span class="box">' + receiptNo + '</span></div>' +
'<div><b>Date</b><span class="box">' + paidDate + '</span></div>' +
'</div>' +
'<div class="content">' +
'<div class="field"><b>Student ID :</b><span class="value">' + studentId + '</span></div>' +
'<div class="field"><b>Student Name :</b><span class="value">' + (data.studentName || "-") + '</span></div>' +
'<div class="two-col">' +
'<div class="field"><b>Class :</b><span class="value">' + className + '</span></div>' +
'<div class="field"><b>Board :</b><span class="value">' + board + '</span></div>' +
'</div>' +
'<div class="field"><b>Course :</b><span class="value">' + courseName + '</span></div>' +
(installment ? '<div class="field"><b>Installment :</b><span class="value">' + installment + '</span></div>' : '') +
'<div class="field"><b>Due Date :</b><span class="value">' + dueDate + '</span></div>' +
