# Backend

PORT=5000
# Set only when the API is behind a trusted reverse proxy that normalizes forwarded headers.
# TRUST_PROXY_HOPS=1

MONGODB_URI=your_mongodb_connection_string

JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
# Optional dedicated access-token signing secret. If unset, the API falls back to SESSION_SECRET or JWT_SECRET.
ACCESS_TOKEN_SECRET=replace_with_a_different_random_secret_of_at_least_32_characters
# Optional pepper for hashed login throttle keys. If unset, ACCESS_TOKEN_SECRET / JWT_SECRET is used.
AUTH_THROTTLE_SECRET=replace_with_a_different_random_secret_of_at_least_32_characters

# Password reset email delivery is disabled unless all of these are configured.
PUBLIC_APP_URL=https://your-parikshadrishti-domain.example
AUTH_ENCRYPTION_KEY=replace_with_a_random_secret_of_at_least_32_characters
AUTH_EMAIL_PROVIDER_URL=https://your-email-provider.example/api/send
AUTH_EMAIL_PROVIDER_TOKEN=your_email_provider_api_token
AUTH_EMAIL_FROM=security@your-parikshadrishti-domain.example

# Optional, used by the API's create-super-admin command
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=use_a_unique_password_at_least_12_chars
SUPER_ADMIN_NAME=Platform Administrator

# Frontend

VITE_API_BASE_URL=http://localhost:5000
